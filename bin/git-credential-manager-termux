#!/data/data/com.termux/files/usr/bin/bash
# Runs Git Credential Manager on the installed .NET runtime. Termux's GCM package
# can require a newer .NET patch release than the repo ships (3.0.2 wants 10.0.14,
# repo has 10.0.13), which makes the stock `git-credential-manager` refuse to start.
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export DOTNET_ROOT="$PREFIX/lib/dotnet"
fx="$(ls "$DOTNET_ROOT/shared/Microsoft.NETCore.App" 2>/dev/null | sort -V | tail -1)"
exec "$DOTNET_ROOT/dotnet" exec --fx-version "$fx" \
  "$PREFIX/lib/git-credential-manager/git-credential-manager.dll" "$@"
